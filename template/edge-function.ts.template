// @ts-nocheck
// Supabase Edge Function: m2m-token
// This function handles the OAuth 2.0 Client Credentials flow for machine-to-machine authentication
// Note: This file is written for Deno runtime (Supabase Edge Functions) and will be type-checked by Deno

import { serve } from 'https://deno.land/std@0.168.0/http/server.ts';
import { createClient } from 'https://esm.sh/@supabase/supabase-js@2';
import { compare } from 'https://deno.land/x/bcrypt@v0.4.1/mod.ts';
import { create, getNumericDate } from 'https://deno.land/x/djwt@v2.8/mod.ts';

const corsHeaders = {
  'Access-Control-Allow-Origin': '{{CORS_ORIGIN}}',
  'Access-Control-Allow-Headers':
    'authorization, x-client-info, apikey, content-type',
};

interface TokenRequest {
  client_id: string;
  client_secret: string;
}

interface MachineSecret {
  client_id: string;
  client_secret_hash: string;
  scopes: string[];
  is_active: boolean;
}

serve(async (req: Request) => {
  // Handle CORS preflight
  if (req.method === 'OPTIONS') {
    return new Response('ok', { headers: corsHeaders });
  }

  try {
    // Get environment variables
    const supabaseUrl = Deno.env.get('SUPABASE_URL') ?? '';
    const supabaseServiceKey = Deno.env.get('SUPABASE_SERVICE_ROLE_KEY') ?? '';
    const jwtSecret = Deno.env.get('JWT_SECRET') ?? '';

    if (!supabaseUrl || !supabaseServiceKey || !jwtSecret) {
      return new Response(
        JSON.stringify({ error: 'Server configuration error' }),
        {
          status: 500,
          headers: { ...corsHeaders, 'Content-Type': 'application/json' },
        }
      );
    }

    // Parse request body
    const body = (await req.json()) as TokenRequest;
    const { client_id, client_secret } = body;

    if (!client_id || !client_secret) {
      return new Response(
        JSON.stringify({ error: 'client_id and client_secret are required' }),
        {
          status: 400,
          headers: { ...corsHeaders, 'Content-Type': 'application/json' },
        }
      );
    }

    // Create Supabase admin client
    const supabase = createClient(supabaseUrl, supabaseServiceKey);

    // Fetch machine secret from database
    const { data, error } = await supabase
      .from('machine_secrets')
      .select('client_id, client_secret_hash, scopes, is_active')
      .eq('client_id', client_id)
      .eq('is_active', true)
      .single();

    if (error || !data) {
      return new Response(
        JSON.stringify({ error: 'Invalid client credentials' }),
        {
          status: 401,
          headers: { ...corsHeaders, 'Content-Type': 'application/json' },
        }
      );
    }

    const machineSecret: MachineSecret = data;

    // Verify client secret using bcrypt
    const isValid = await compare(
      client_secret,
      machineSecret.client_secret_hash
    );
    if (!isValid) {
      return new Response(
        JSON.stringify({ error: 'Invalid client credentials' }),
        {
          status: 401,
          headers: { ...corsHeaders, 'Content-Type': 'application/json' },
        }
      );
    }

    // Generate JWT token
    const now = new Date();
    const exp = new Date(now.getTime() + {{TOKEN_EXPIRY_SECONDS}} * 1000); // {{TOKEN_EXPIRY_MINUTES}} minutes expiration

    const payload = {
      sub: machineSecret.client_id,
      role: 'service',
      scopes: machineSecret.scopes,
      iss: supabaseUrl,
      exp: getNumericDate(exp),
      iat: getNumericDate(now),
    };

    // Sign JWT using HS256 algorithm
    const key = await crypto.subtle.importKey(
      'raw',
      new TextEncoder().encode(jwtSecret),
      { name: 'HMAC', hash: 'SHA-256' },
      false,
      ['sign']
    );

    const jwt = await create({ alg: 'HS256', typ: 'JWT' }, payload, key);

    return new Response(
      JSON.stringify({
        access_token: jwt,
        token_type: 'Bearer',
        expires_in: {{TOKEN_EXPIRY_SECONDS}},
        scope: machineSecret.scopes.join(' '),
      }),
      {
        status: 200,
        headers: { ...corsHeaders, 'Content-Type': 'application/json' },
      }
    );
  } catch (error) {
    console.error('Error in m2m-token function:', error);
    return new Response(JSON.stringify({ error: 'Internal server error' }), {
      status: 500,
      headers: { ...corsHeaders, 'Content-Type': 'application/json' },
    });
  }
});

